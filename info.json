{
  "name": "ltn-space-exploration",
  "version": "2.0.2",
  "title": "LTN - Space Exploration Integration",
  "description": "Integrates LTN with Space Exploration",
  "author": "hgschmie",
  "contact": "https://github.com/hgschmie/factorio-ltn-space-exploration/issues",
  "homepage": "https://github.com/hgschmie/factorio-ltn-space-exploration",
  "factorio_version": "2.1",
  "dependencies": [
    "base >= 2.1.7",
    "LogisticTrainNetwork >= 2.7.1",
    "space-exploration >= 0.7.59",
    "! se-ltn-glue"
  ],
  "package": {
    "git_publish_branch": "main",
    "readme": "README.md",
    "gallery": [
      ".portal/ltn-se-1.png"
    ],
    "sync_portal_details": true,
    "ignore": [
      "graphics/src/*",
      "portal/*",
      "releases/*",
      "**/*.xcf",
      "**/.zip",
      ".git",
      ".gitignore",
      ".vscode",
      ".claude",
      "CLAUDE.md",
      ".DS_Store"
    ]
  }
}
